<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the Access VBA plugin's symbol layer (declaration parser, index, completion engine).
    Built independently of IdePlusPlus.slnx, like the plugin itself - it references the plugin
    project, which in turn references AccessMCP.Core from the separate AccessMCP repo.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AccessVbaPlugin\AccessVbaPlugin.csproj" />
  </ItemGroup>

</Project>
