<UserControl x:Class="AccessVbaPlugin.AccessVbaToolWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="4">
            <Button DockPanel.Dock="Right" Content="Refresh List" Click="RefreshModules_Click" Margin="4,0,0,0" />
            <ComboBox x:Name="ModuleComboBox" SelectionChanged="ModuleComboBox_SelectionChanged" />
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="4,0,4,4">
            <Button DockPanel.Dock="Right" x:Name="ImportChangedButton" Content="Import Changed from Folder"
                    Click="ImportChanged_Click" Margin="4,0,0,0" />
            <Button DockPanel.Dock="Right" x:Name="ExportAllButton" Content="Export All to Folder"
                    Click="ExportAll_Click" Margin="4,0,0,0" />
            <TextBlock Text="Git export folder:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox x:Name="ExportFolderTextBox" VerticalAlignment="Center" />
        </DockPanel>

        <DockPanel Grid.Row="2" Margin="4,0,4,4" LastChildFill="False">
            <TextBlock Text="Drift vs Access:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <Button x:Name="CheckDriftButton" Content="Check Drift" Click="CheckDrift_Click" Margin="4,0,0,0" />
            <Button x:Name="PullDriftedButton" Content="Pull Drifted" Click="PullDrifted_Click" Margin="4,0,0,0" />
            <Button x:Name="MarkResolvedButton" Content="Mark Selected Resolved" Click="MarkResolved_Click" Margin="4,0,0,0" />
        </DockPanel>

        <avalonEdit:TextEditor x:Name="Editor" Grid.Row="3" Margin="4"
                                FontFamily="Consolas" FontSize="13"
                                ShowLineNumbers="True" WordWrap="False" />

        <DockPanel Grid.Row="4" Margin="4">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Right" VerticalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="320" Margin="12,0,0,0" />
            <Button x:Name="PullButton" Content="Pull" Click="Pull_Click" Width="80" />
            <Button x:Name="PushButton" Content="Push" Click="Push_Click" Width="80" Margin="4,0,0,0" />
            <CheckBox x:Name="CompileCheckBox" Content="Compile on push" IsChecked="True"
                      VerticalAlignment="Center" Margin="12,0,0,0" />
            <Button x:Name="CompileCheckButton" Content="Compile Check" Click="CompileCheck_Click"
                    Width="100" Margin="12,0,0,0" />
        </DockPanel>
    </Grid>
</UserControl>
