<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <!-- Only needed to compile against Microsoft.Build.Evaluation.Project directly in
         TestProjectDetectorTests - mirrors IdePlusPlus.ProjectSystem.csproj's own reference; the
         actual runtime assembly comes from MSBuildLocator.RegisterDefaults() (via
         SolutionLoader.EnsureMSBuildRegistered), not from this package. -->
    <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IdePlusPlus.ProjectSystem\IdePlusPlus.ProjectSystem.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\samples\SampleConsoleApp\**"
          LinkBase="Fixtures\SampleConsoleApp\"
          CopyToOutputDirectory="PreserveNewest"
          Exclude="..\..\samples\SampleConsoleApp\bin\**;..\..\samples\SampleConsoleApp\obj\**" />
    <None Include="..\..\samples\SampleMultiTargetApp\**"
          LinkBase="Fixtures\SampleMultiTargetApp\"
          CopyToOutputDirectory="PreserveNewest"
          Exclude="..\..\samples\SampleMultiTargetApp\bin\**;..\..\samples\SampleMultiTargetApp\obj\**" />
  </ItemGroup>

</Project>
