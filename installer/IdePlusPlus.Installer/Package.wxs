<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!--
    Scope="perUser": installs under %LOCALAPPDATA%\Programs, no admin/UAC prompt, shortcut just for
    the installing account - deliberately not ProgramFilesFolder/perMachine.

    UpgradeCode must never change across future versions - it is the only thing that lets Windows
    Installer recognize a new build as an upgrade of this same product rather than an unrelated one.
    Version does change every release; ProductCode is left unset so WiX generates a fresh one on
    every build, which MajorUpgrade below relies on to detect and remove the previous version.
  -->
  <Package Name="IDE++"
           Manufacturer="Mark Perry"
           Version="$(var.ProductVersion)"
           UpgradeCode="39A87D0B-7126-4E2B-BF33-F45128C3B6B2"
           Scope="perUser">

    <MajorUpgrade DowngradeErrorMessage="A newer version of IDE++ is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon.ico" SourceFile="..\..\src\IdePlusPlus.Shell\Assets\AppIcon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <!-- No ARPNOMODIFY here - the WixUI_InstallDir dialog set below already sets it (it has no
         Modify flow of its own either), and a second declaration is a duplicate-identifier error. -->

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="IDE++">
          <!-- Harvests every file dotnet publish produced - a self-contained WPF publish is 150+
               files (the app's own assemblies, the .NET runtime, and one satellite-resource
               subdirectory per localized culture) that would be impractical to hand-author. -->
          <Files Include="$(var.AppPublishDir)**" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="IDE++">
        <Component Id="ApplicationShortcut" Guid="*">
          <Shortcut Id="ApplicationStartMenuShortcut"
                    Name="IDE++"
                    Description="The IDE++ IDE"
                    Target="[INSTALLFOLDER]IdePlusPlus.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="AppIcon.ico" />
          <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
          <!-- A Component needs a KeyPath to know whether it's "installed" - this shortcut writes no
               file of its own, so a registry value stands in for one, the standard WiX idiom for a
               shortcut-only component. -->
          <RegistryValue Root="HKCU"
                          Key="Software\Mark Perry\IDE++"
                          Name="StartMenuShortcutInstalled"
                          Type="integer"
                          Value="1"
                          KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- No explicit Feature authored - WiX provides a default feature covering everything above
         when none is given (since v5), which is all a single-purpose installer like this one needs. -->

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="Assets\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="Assets\dialog.bmp" />

  </Package>
</Wix>
