<Project>
  <!-- Deliberately empty (and deliberately present): MSBuild auto-imports the nearest
       Directory.Build.props found by walking up from a project's own directory, and stops at the
       first one - without this file, the installer's .wixproj would pick up the repo root's
       Directory.Build.props instead, including <TargetFramework>net10.0-windows</TargetFramework>,
       which doesn't mean anything for a WiX package (it doesn't produce a .NET assembly) and risks
       confusing the WixToolset.Sdk's own build logic. This file isolates the installer subtree
       from the rest of the repo's C#-project-specific defaults. -->
</Project>
