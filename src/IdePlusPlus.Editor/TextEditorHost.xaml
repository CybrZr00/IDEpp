<UserControl x:Class="IdePlusPlus.Editor.TextEditorHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:diff="clr-namespace:IdePlusPlus.Editor.Diff">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type diff:DiffLine}">
            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Added">
                                <Setter Property="Background" Value="{DynamicResource DiffAddedBackgroundBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                <Setter Property="Background" Value="{DynamicResource DiffRemovedBackgroundBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Kind, Mode=OneWay, Converter={x:Static diff:DiffLinePrefixConverter.Instance}}"
                               FontWeight="Bold"
                               FontFamily="Consolas"
                               FontSize="11" />
                    <TextBlock Text="{Binding Text, Mode=OneWay}"
                               FontFamily="Consolas"
                               FontSize="11"
                               Visibility="{Binding HasSegments, Converter={x:Static diff:InverseBoolToVisibilityConverter.Instance}}" />
                    <ItemsControl ItemsSource="{Binding Segments}"
                                  Visibility="{Binding HasSegments, Converter={x:Static diff:BoolToVisibilityConverter.Instance}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type diff:DiffTextSegment}">
                                <TextBlock Text="{Binding Text, Mode=OneWay}" FontFamily="Consolas" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource DiffHighlightBackgroundBrush}" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <Border x:Name="DiffReviewPanel"
                DockPanel.Dock="Top"
                Visibility="Collapsed"
                Padding="8"
                BorderThickness="0,0,0,1"
                Background="{DynamicResource EditProposalBackgroundBrush}"
                BorderBrush="{DynamicResource EditProposalBorderBrush}">
            <StackPanel>
                <DockPanel>
                    <Button x:Name="DismissPreviewButton"
                            DockPanel.Dock="Right"
                            Content="✕"
                            Width="18"
                            Height="18"
                            Padding="0"
                            FontSize="10"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="DismissPreviewButton_OnClick"
                            ToolTip="Dismiss" />
                    <TextBlock x:Name="ChangeSummaryText" FontWeight="Bold" TextWrapping="Wrap" />
                </DockPanel>

                <ScrollViewer MaxHeight="240"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,4,0,0">
                    <ItemsControl x:Name="DiffLinesControl" />
                </ScrollViewer>

                <StackPanel x:Name="DecisionButtonsPanel" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Accept" Click="AcceptPreviewButton_OnClick" Padding="8,2" />
                    <Button Content="Reject" Click="RejectPreviewButton_OnClick" Margin="6,0,0,0" Padding="8,2" />
                </StackPanel>

                <TextBlock x:Name="DecisionTextBlock"
                           Margin="0,6,0,0"
                           FontStyle="Italic"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <avalonEdit:TextEditor x:Name="Editor"
                                FontFamily="Consolas"
                                ShowLineNumbers="True"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Auto" />
    </DockPanel>
</UserControl>
