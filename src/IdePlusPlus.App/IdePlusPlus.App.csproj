<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>IdePlusPlus</AssemblyName>
    <!-- Same source image as MainWindow.xaml's Icon and the About/Welcome logo, embedded here too
         so the built .exe itself (Explorer, taskbar pin, shortcuts) shows it, not just the running
         window. -->
    <ApplicationIcon>..\IdePlusPlus.Shell\Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same MSBL001 fix as IdePlusPlus.Shell.csproj - App also resolves
         Microsoft.CodeAnalysis.Workspaces.MSBuild transitively (via IdePlusPlus.Roslyn), which
         Microsoft.Build.Locator's build-time analyzer flags without this exclusion. -->
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.StringTools" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IdePlusPlus.Shell\IdePlusPlus.Shell.csproj" />
    <ProjectReference Include="..\IdePlusPlus.Editor\IdePlusPlus.Editor.csproj" />
    <ProjectReference Include="..\IdePlusPlus.ProjectSystem\IdePlusPlus.ProjectSystem.csproj" />
    <ProjectReference Include="..\IdePlusPlus.Build\IdePlusPlus.Build.csproj" />
    <ProjectReference Include="..\IdePlusPlus.Run\IdePlusPlus.Run.csproj" />
    <ProjectReference Include="..\IdePlusPlus.Debug\IdePlusPlus.Debug.csproj" />
    <ProjectReference Include="..\IdePlusPlus.Copilot.Core\IdePlusPlus.Copilot.Core.csproj" />
    <ProjectReference Include="..\IdePlusPlus.Copilot.OpenRouter\IdePlusPlus.Copilot.OpenRouter.csproj" />
    <ProjectReference Include="..\IdePlusPlus.Infrastructure\IdePlusPlus.Infrastructure.csproj" />
    <ProjectReference Include="..\IdePlusPlus.Copilot.Diff\IdePlusPlus.Copilot.Diff.csproj" />
    <ProjectReference Include="..\IdePlusPlus.Copilot.DeepSeek\IdePlusPlus.Copilot.DeepSeek.csproj" />
    <ProjectReference Include="..\IdePlusPlus.Copilot.Embeddings\IdePlusPlus.Copilot.Embeddings.csproj" />
    <ProjectReference Include="..\IdePlusPlus.Copilot.Memory\IdePlusPlus.Copilot.Memory.csproj" />
    <ProjectReference Include="..\IdePlusPlus.Copilot.LmStudio\IdePlusPlus.Copilot.LmStudio.csproj" />
    <ProjectReference Include="..\IdePlusPlus.Copilot.Mcp\IdePlusPlus.Copilot.Mcp.csproj" />
    <ProjectReference Include="..\IdePlusPlus.SourceControl\IdePlusPlus.SourceControl.csproj" />
    <ProjectReference Include="..\IdePlusPlus.NuGet\IdePlusPlus.NuGet.csproj" />
    <ProjectReference Include="..\IdePlusPlus.TestRunner\IdePlusPlus.TestRunner.csproj" />
    <ProjectReference Include="..\IdePlusPlus.Roslyn\IdePlusPlus.Roslyn.csproj" />
  </ItemGroup>

</Project>
