<Project>
  <!--
    Produces a self-contained single-file IdePlusPlus.exe that runs on a machine with no .NET
    runtime installed - run `dotnet publish src/IdePlusPlus.App/IdePlusPlus.App.csproj
    -p:PublishProfile=win-x64 -c Release`.

    This does NOT remove the need for a .NET SDK on the machine running IDE++: Build/Run/Debug and
    Open Solution use Microsoft.Build.Locator to find and drive the machine's installed MSBuild at
    runtime (see SolutionLoader.EnsureMSBuildRegistered), which is orthogonal to how IDE++ itself is
    deployed. Self-contained-vs-framework-dependent only affects whether *launching IDE++* needs a
    .NET runtime pre-installed; it doesn't - and can't - remove the requirement that building .NET
    projects needs a .NET SDK/MSBuild present somewhere on the machine.
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Release\net10.0-windows\win-x64\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
