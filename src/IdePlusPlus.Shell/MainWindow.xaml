<Window x:Class="IdePlusPlus.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
        xmlns:controls="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
        xmlns:themes="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.VS2013"
        xmlns:toolPanes="clr-namespace:IdePlusPlus.Shell.ToolPanes"
        xmlns:local="clr-namespace:IdePlusPlus.Shell"
        xmlns:editor="clr-namespace:IdePlusPlus.Editor;assembly=IdePlusPlus.Editor"
        xmlns:projectSystem="clr-namespace:IdePlusPlus.ProjectSystem;assembly=IdePlusPlus.ProjectSystem"
        xmlns:debug="clr-namespace:IdePlusPlus.Debug;assembly=IdePlusPlus.Debug"
        xmlns:build="clr-namespace:IdePlusPlus.Build;assembly=IdePlusPlus.Build"
        xmlns:views="clr-namespace:IdePlusPlus.Shell.Views"
        Title="{Binding WindowTitle}"
        Height="800"
        Width="1280"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="MainWindow_OnDrop">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding StartDebuggingCommand}" />
        <KeyBinding Key="F5" Modifiers="Control" Command="{Binding ContinueDebuggingCommand}" />
        <KeyBinding Key="F10" Command="{Binding StepOverCommand}" />
        <KeyBinding Key="F11" Command="{Binding StepIntoCommand}" />
        <KeyBinding Key="F11" Modifiers="Shift" Command="{Binding StepOutCommand}" />
        <KeyBinding Key="G" Modifiers="Control" Command="{x:Static local:MainWindow.GoToLineCommand}" />
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="D0" Modifiers="Control" Command="{Binding ResetZoomCommand}" />
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.GoToLineCommand}"
                         CanExecute="GoToLineCommand_OnCanExecute"
                         Executed="GoToLineCommand_OnExecuted" />
    </Window.CommandBindings>

    <Window.Resources>
        <!--
            WPF's default (Aero2) MenuItem control template hardcodes its dropdown/submenu popup
            chrome to OS system colors, not to any resource this app's theme can reach - overriding
            SystemColors.MenuBrushKey/MenuTextBrushKey has no effect on it (tried, confirmed live:
            the popup stayed light regardless of theme). The only reliable fix is a real
            ControlTemplate of our own. Implicit (no x:Key) so it applies to every MenuItem in this
            Window's logical tree, including nested submenus and the Solution Explorer context menu.
        -->
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}" />
            <Style.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Border x:Name="Border" Background="{TemplateBinding Background}">
                                    <Grid>
                                        <ContentPresenter Margin="6,3"
                                                           ContentSource="Header"
                                                           RecognizesAccessKey="True"
                                                           VerticalAlignment="Center" />
                                        <Popup x:Name="Popup"
                                               Placement="Bottom"
                                               IsOpen="{TemplateBinding IsSubmenuOpen}"
                                               AllowsTransparency="True"
                                               Focusable="False"
                                               PopupAnimation="Fade">
                                            <Border Background="{DynamicResource PanelBackgroundBrush}"
                                                    BorderBrush="{DynamicResource EditProposalBorderBrush}"
                                                    BorderThickness="1">
                                                <ScrollViewer CanContentScroll="True">
                                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                                </ScrollViewer>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource MenuHighlightBackgroundBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSubmenuOpen" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource MenuHighlightBackgroundBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Role" Value="SubmenuHeader">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Border x:Name="Border" Background="{TemplateBinding Background}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="16" />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter Grid.Column="1"
                                                           Margin="4,4"
                                                           ContentSource="Header"
                                                           RecognizesAccessKey="True"
                                                           VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{TemplateBinding InputGestureText}"
                                                   Margin="16,0,4,0"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   VerticalAlignment="Center" />
                                        <Path Grid.Column="3"
                                              Data="M0,0 L4,4 L0,8 Z"
                                              Fill="{TemplateBinding Foreground}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center" />
                                        <Popup x:Name="Popup"
                                               Placement="Right"
                                               IsOpen="{TemplateBinding IsSubmenuOpen}"
                                               AllowsTransparency="True"
                                               Focusable="False"
                                               PopupAnimation="Fade">
                                            <Border Background="{DynamicResource PanelBackgroundBrush}"
                                                    BorderBrush="{DynamicResource EditProposalBorderBrush}"
                                                    BorderThickness="1">
                                                <ScrollViewer CanContentScroll="True">
                                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                                </ScrollViewer>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource MenuHighlightBackgroundBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Role" Value="SubmenuItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Border x:Name="Border" Background="{TemplateBinding Background}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Path x:Name="CheckMark"
                                              Grid.Column="0"
                                              Data="M1,4 L4,7 L9,0"
                                              Stroke="{TemplateBinding Foreground}"
                                              StrokeThickness="1.5"
                                              Visibility="Collapsed"
                                              Margin="4,0,0,0"
                                              VerticalAlignment="Center" />
                                        <ContentPresenter Grid.Column="1"
                                                           Margin="4,4"
                                                           ContentSource="Header"
                                                           RecognizesAccessKey="True"
                                                           VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{TemplateBinding InputGestureText}"
                                                   Margin="16,0,8,0"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource MenuHighlightBackgroundBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type projectSystem:SolutionTreeNode}" ItemsSource="{Binding Children}">
            <!-- Foreground must be set explicitly here, not just on the TreeView - the default
                 themed TreeViewItem template hardcodes its own (light-theme) text color via
                 SystemColors, which otherwise wins over the TreeView's inherited Foreground. -->
            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource WindowForegroundBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStartupProject}" Value="True">
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </HierarchicalDataTemplate>
        <DataTemplate DataType="{x:Type toolPanes:SolutionExplorerPaneViewModel}">
            <TreeView ItemsSource="{Binding RootNodes}"
                      Background="{DynamicResource PanelBackgroundBrush}"
                      Foreground="{DynamicResource WindowForegroundBrush}"
                      BorderThickness="0"
                      MouseDoubleClick="SolutionExplorerTree_OnMouseDoubleClick"
                      PreviewMouseRightButtonDown="SolutionExplorerTree_OnPreviewMouseRightButtonDown" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type toolPanes:OutputPaneViewModel}">
            <TextBox Text="{Binding Text, Mode=OneWay}"
                     Background="{DynamicResource PanelBackgroundBrush}"
                     Foreground="{DynamicResource WindowForegroundBrush}"
                     IsReadOnly="True"
                     BorderThickness="0"
                     FontFamily="Consolas"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextChanged="OutputTextBox_OnTextChanged" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type toolPanes:ErrorListPaneViewModel}">
            <ListBox ItemsSource="{Binding Diagnostics}"
                     Background="{DynamicResource PanelBackgroundBrush}"
                     Foreground="{DynamicResource WindowForegroundBrush}"
                     BorderThickness="0"
                     FontFamily="Consolas"
                     MouseDoubleClick="ErrorListBox_OnMouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type build:BuildDiagnostic}">
                        <TextBlock FontSize="11">
                            <Run Text="{Binding Severity, Mode=OneWay}" FontWeight="Bold" />
                            <Run Text="{Binding Code, Mode=OneWay}" />
                            <Run Text="{Binding Message, Mode=OneWay}" />
                            <Run Text=" — " Foreground="{DynamicResource MutedForegroundBrush}" />
                            <Run Text="{Binding FilePath, Mode=OneWay}" Foreground="{DynamicResource MutedForegroundBrush}" />
                            <Run Text=":" Foreground="{DynamicResource MutedForegroundBrush}" />
                            <Run Text="{Binding Line, Mode=OneWay}" Foreground="{DynamicResource MutedForegroundBrush}" />
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type toolPanes:TestTreeNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Outcome, Converter={x:Static toolPanes:TestOutcomeToGlyphConverter.Instance}}"
                           Foreground="{Binding Outcome, Converter={x:Static toolPanes:TestOutcomeToBrushConverter.Instance}}"
                           FontWeight="Bold"
                           Margin="0,0,4,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Method">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- Foreground set explicitly, same reason as the Solution Explorer template above -
                     the default themed TreeViewItem template hardcodes light-theme text color. -->
                <TextBlock Text="{Binding Name}"
                           Foreground="{DynamicResource WindowForegroundBrush}"
                           ToolTip="{Binding ErrorMessage}" />
            </StackPanel>
        </HierarchicalDataTemplate>
        <DataTemplate DataType="{x:Type toolPanes:TestExplorerPaneViewModel}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
                    <Button Content="Run All" Command="{Binding RunAllCommand}" Margin="0,0,4,0" />
                    <Button Content="Run Selected" Command="{Binding RunSelectedCommand}" Margin="0,0,4,0" />
                    <Button Content="Run Failed" Command="{Binding RunFailedCommand}" Margin="0,0,4,0" />
                    <Button Content="Cancel" Command="{Binding CancelCommand}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom"
                           Text="{Binding Summary}"
                           Margin="4,2"
                           FontSize="11"
                           Foreground="{DynamicResource MutedForegroundBrush}" />
                <TreeView ItemsSource="{Binding Tree}"
                          Background="{DynamicResource PanelBackgroundBrush}"
                          Foreground="{DynamicResource WindowForegroundBrush}"
                          BorderThickness="0"
                          MouseDoubleClick="TestTreeView_OnMouseDoubleClick"
                          SelectedItemChanged="TestTreeView_OnSelectedItemChanged" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type toolPanes:CopilotChatPaneViewModel}">
            <views:CopilotChatPanel />
        </DataTemplate>
        <DataTemplate DataType="{x:Type toolPanes:SourceControlPaneViewModel}">
            <views:SourceControlPanel />
        </DataTemplate>
        <DataTemplate DataType="{x:Type toolPanes:NuGetPaneViewModel}">
            <views:NuGetPanel />
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:WelcomeDocumentViewModel}">
            <TextBlock Text="{Binding Message}"
                       Margin="16"
                       FontSize="16" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type editor:DocumentViewModel}">
            <editor:TextEditorHost />
        </DataTemplate>
        <!--
            Shared by the Call Stack and Locals templates below: a session-picker header, only
            meaningful once more than one DebugSession is running (multi-project debug/attach) - with
            0-1 sessions it's a harmless no-op rather than being hidden, to keep the XAML simple.
        -->
        <DataTemplate x:Key="DebugSessionPickerHeader">
            <Grid Margin="4,2"
                  DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Session:" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding DebugSessions}"
                          SelectedItem="{Binding ActiveDebugSession}"
                          DisplayMemberPath="DisplayName"
                          FontSize="11" />
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type toolPanes:CallStackPaneViewModel}">
            <DockPanel>
                <ContentControl DockPanel.Dock="Top" ContentTemplate="{StaticResource DebugSessionPickerHeader}" />
                <ListBox ItemsSource="{Binding Frames}"
                         Background="{DynamicResource PanelBackgroundBrush}"
                         Foreground="{DynamicResource WindowForegroundBrush}"
                         BorderThickness="0"
                         FontFamily="Consolas">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type debug:StackFrameInfo}">
                            <TextBlock>
                                <Run Text="{Binding Name, Mode=OneWay}" />
                                <Run Text=" — " />
                                <Run Text="{Binding FilePath, Mode=OneWay}" />
                                <Run Text=":" />
                                <Run Text="{Binding Line, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type toolPanes:LocalsPaneViewModel}">
            <DockPanel>
                <ContentControl DockPanel.Dock="Top" ContentTemplate="{StaticResource DebugSessionPickerHeader}" />
                <ListBox ItemsSource="{Binding Variables}"
                         Background="{DynamicResource PanelBackgroundBrush}"
                         Foreground="{DynamicResource WindowForegroundBrush}"
                         BorderThickness="0"
                         FontFamily="Consolas">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type debug:VariableInfo}">
                            <TextBlock>
                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="Bold" />
                                <Run Text=" = " />
                                <Run Text="{Binding Value, Mode=OneWay}" />
                                <Run Text=" : " />
                                <Run Text="{Binding Type, Mode=OneWay}" Foreground="{DynamicResource MutedForegroundBrush}" />
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}"
          TextElement.Foreground="{DynamicResource WindowForegroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0"
              Background="{DynamicResource WindowBackgroundBrush}"
              Foreground="{DynamicResource WindowForegroundBrush}">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Command="{Binding NewDocumentCommand}" />
                <MenuItem Header="_Open..." Command="{Binding OpenDocumentCommand}" />
                <MenuItem Header="Open _Solution..." Command="{Binding OpenSolutionCommand}" />
                <MenuItem Header="_Save" Command="{Binding SaveCommand}" />
                <MenuItem Header="Save _As..." Command="{Binding SaveAsCommand}" />
                <MenuItem Header="Save A_ll" Command="{Binding SaveAllCommand}" />
                <MenuItem Header="Close A_ll" Click="CloseAllMenuItem_OnClick" />
                <Separator />
                <MenuItem Header="Recent Files" ItemsSource="{Binding RecentFiles}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Converter={x:Static toolPanes:FileNameConverter.Instance}}" />
                            <Setter Property="ToolTip" Value="{Binding}" />
                            <Setter Property="Command" Value="{Binding DataContext.OpenRecentFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="Recent Solutions" ItemsSource="{Binding RecentSolutions}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Converter={x:Static toolPanes:FileNameConverter.Instance}}" />
                            <Setter Property="ToolTip" Value="{Binding}" />
                            <Setter Property="Command" Value="{Binding DataContext.OpenRecentSolutionCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator />
                <MenuItem Header="E_xit" Click="ExitMenuItem_OnClick" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Find..." Command="ApplicationCommands.Find" InputGestureText="Ctrl+F" />
                <MenuItem Header="_Replace..." Command="ApplicationCommands.Replace" InputGestureText="Ctrl+H" />
                <Separator />
                <MenuItem Header="_Go to Line..." Command="{x:Static local:MainWindow.GoToLineCommand}" InputGestureText="Ctrl+G" />
            </MenuItem>
            <MenuItem Header="_Build">
                <MenuItem Header="_Build Solution" Command="{Binding BuildCommand}" />
                <MenuItem Header="_Clean Solution" Command="{Binding CleanCommand}" />
                <MenuItem Header="_Rebuild Solution" Command="{Binding RebuildCommand}" />
                <Separator />
                <MenuItem Header="_Run" Command="{Binding RunCommand}" />
                <MenuItem Header="_Stop" Command="{Binding StopCommand}" />
            </MenuItem>
            <MenuItem Header="_Debug">
                <MenuItem Header="Start De_bugging" InputGestureText="F5" Command="{Binding StartDebuggingCommand}" />
                <MenuItem Header="Sto_p Debugging" Command="{Binding StopDebuggingCommand}" />
                <MenuItem Header="_Attach to Process..." Command="{Binding AttachToProcessCommand}" />
                <Separator />
                <MenuItem Header="_Continue" InputGestureText="Ctrl+F5" Command="{Binding ContinueDebuggingCommand}" />
                <MenuItem Header="Step _Over" InputGestureText="F10" Command="{Binding StepOverCommand}" />
                <MenuItem Header="Step _Into" InputGestureText="F11" Command="{Binding StepIntoCommand}" />
                <MenuItem Header="Step Ou_t" InputGestureText="Shift+F11" Command="{Binding StepOutCommand}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Dark Mode" IsCheckable="True" IsChecked="{Binding IsDarkTheme, Mode=OneWay}" Command="{Binding ToggleThemeCommand}" />
                <MenuItem Header="_Word Wrap" IsCheckable="True" IsChecked="{Binding IsWordWrapEnabled, Mode=OneWay}" Command="{Binding ToggleWordWrapCommand}" />
                <Separator />
                <MenuItem Header="Zoom _In" InputGestureText="Ctrl+=" Command="{Binding ZoomInCommand}" />
                <MenuItem Header="Zoom _Out" InputGestureText="Ctrl+-" Command="{Binding ZoomOutCommand}" />
                <MenuItem Header="_Reset Zoom" InputGestureText="Ctrl+0" Command="{Binding ResetZoomCommand}" />
            </MenuItem>
            <MenuItem Header="_Git" DataContext="{Binding SourceControl}">
                <MenuItem Header="_Refresh Status" Command="{Binding RefreshCommand}" />
                <Separator />
                <MenuItem Header="_Commit" Command="{Binding CommitCommand}" />
                <Separator />
                <MenuItem Header="_Fetch" Command="{Binding FetchCommand}" />
                <MenuItem Header="_Pull" Command="{Binding PullCommand}" />
                <MenuItem Header="P_ush" Command="{Binding PushCommand}" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Settings..." Click="SettingsMenuItem_OnClick" />
                <Separator />
                <MenuItem Header="Plugins" ItemsSource="{Binding PluginCommands}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Header}" />
                            <Setter Property="Command" Value="{Binding Command}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About IDE++..." Click="AboutMenuItem_OnClick" />
            </MenuItem>
        </Menu>

        <avalonDock:DockingManager x:Name="DockManager"
                                    Grid.Row="1"
                                    DocumentsSource="{Binding OpenDocuments}"
                                    ActiveContent="{Binding ActiveDocument, Mode=TwoWay}"
                                    DocumentClosing="DockManager_OnDocumentClosing"
                                    DocumentClosed="DockManager_OnDocumentClosed">
            <avalonDock:DockingManager.Theme>
                <themes:Vs2013LightTheme />
            </avalonDock:DockingManager.Theme>

            <avalonDock:DockingManager.LayoutItemContainerStyle>
                <Style TargetType="{x:Type controls:LayoutItem}">
                    <Setter Property="Title" Value="{Binding Model.Title}" />
                    <Setter Property="ContentId" Value="{Binding Model.ContentId}" />
                    <Setter Property="ToolTip" Value="{Binding Model.FilePath}" />
                    <Setter Property="CanClose" Value="True" />
                </Style>
            </avalonDock:DockingManager.LayoutItemContainerStyle>

            <avalonDock:LayoutRoot>
                <avalonDock:LayoutPanel Orientation="Horizontal">

                    <avalonDock:LayoutAnchorablePane DockWidth="220">
                        <avalonDock:LayoutAnchorable x:Name="SolutionExplorerAnchorable"
                                                      ContentId="{x:Static toolPanes:SolutionExplorerPaneViewModel.PaneContentId}"
                                                      Title="Solution Explorer"
                                                      CanClose="False" />
                        <avalonDock:LayoutAnchorable x:Name="SourceControlAnchorable"
                                                      ContentId="{x:Static toolPanes:SourceControlPaneViewModel.PaneContentId}"
                                                      Title="Git"
                                                      CanClose="False" />
                        <avalonDock:LayoutAnchorable x:Name="NuGetAnchorable"
                                                      ContentId="{x:Static toolPanes:NuGetPaneViewModel.PaneContentId}"
                                                      Title="NuGet"
                                                      CanClose="False" />
                    </avalonDock:LayoutAnchorablePane>

                    <avalonDock:LayoutPanel Orientation="Vertical">
                        <avalonDock:LayoutDocumentPane>
                            <avalonDock:LayoutDocument x:Name="WelcomeDocument"
                                                        ContentId="{x:Static local:WelcomeDocumentViewModel.ContentId}"
                                                        Title="Welcome"
                                                        CanClose="False" />
                        </avalonDock:LayoutDocumentPane>

                        <avalonDock:LayoutAnchorablePane DockHeight="180">
                            <avalonDock:LayoutAnchorable x:Name="OutputAnchorable"
                                                          ContentId="{x:Static toolPanes:OutputPaneViewModel.PaneContentId}"
                                                          Title="Output"
                                                          CanClose="False" />
                            <avalonDock:LayoutAnchorable x:Name="ErrorListAnchorable"
                                                          ContentId="{x:Static toolPanes:ErrorListPaneViewModel.PaneContentId}"
                                                          Title="Error List"
                                                          CanClose="False" />
                            <avalonDock:LayoutAnchorable x:Name="TestExplorerAnchorable"
                                                          ContentId="{x:Static toolPanes:TestExplorerPaneViewModel.PaneContentId}"
                                                          Title="Tests"
                                                          CanClose="False" />
                            <avalonDock:LayoutAnchorable x:Name="CallStackAnchorable"
                                                          ContentId="{x:Static toolPanes:CallStackPaneViewModel.PaneContentId}"
                                                          Title="Call Stack"
                                                          CanClose="False" />
                            <avalonDock:LayoutAnchorable x:Name="LocalsAnchorable"
                                                          ContentId="{x:Static toolPanes:LocalsPaneViewModel.PaneContentId}"
                                                          Title="Locals"
                                                          CanClose="False" />
                        </avalonDock:LayoutAnchorablePane>
                    </avalonDock:LayoutPanel>

                    <avalonDock:LayoutAnchorablePane DockWidth="320">
                        <avalonDock:LayoutAnchorable x:Name="CopilotChatAnchorable"
                                                      ContentId="{x:Static toolPanes:CopilotChatPaneViewModel.PaneContentId}"
                                                      Title="Copilot Chat"
                                                      CanClose="False" />
                    </avalonDock:LayoutAnchorablePane>

                </avalonDock:LayoutPanel>
            </avalonDock:LayoutRoot>
        </avalonDock:DockingManager>

        <StatusBar Grid.Row="2"
                   Background="{DynamicResource WindowBackgroundBrush}"
                   Foreground="{DynamicResource WindowForegroundBrush}">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusBarText}" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding SourceControl.BranchStatusText}" Margin="16,0,0,0" />
            </StatusBarItem>
            <StatusBarItem>
                <ComboBox ItemsSource="{Binding AvailableConfigurations}"
                          SelectedItem="{Binding Configuration}"
                          Margin="16,0,0,0"
                          Width="80"
                          FontSize="11"
                          ToolTip="Build/Run/Debug configuration" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ActiveDocument.SyntaxHighlighting.Name}" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding CursorPositionText}" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
