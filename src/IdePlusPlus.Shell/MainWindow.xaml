<Window x:Class="IdePlusPlus.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
        xmlns:themes="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.VS2013"
        xmlns:toolPanes="clr-namespace:IdePlusPlus.Shell.ToolPanes"
        xmlns:local="clr-namespace:IdePlusPlus.Shell"
        Title="IDE++"
        Height="800"
        Width="1280"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type toolPanes:SolutionExplorerPaneViewModel}">
            <TextBlock Text="Solution Explorer — open a solution to populate this tree."
                       Margin="8"
                       TextWrapping="Wrap" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type toolPanes:OutputPaneViewModel}">
            <TextBlock Text="Build and run output will stream here."
                       Margin="8"
                       TextWrapping="Wrap" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type toolPanes:CopilotChatPaneViewModel}">
            <TextBlock Text="Copilot chat panel — OpenRouter integration lands in a later milestone."
                       Margin="8"
                       TextWrapping="Wrap" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:WelcomeDocumentViewModel}">
            <TextBlock Text="{Binding Message}"
                       Margin="16"
                       FontSize="16" />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <avalonDock:DockingManager x:Name="DockManager">
            <avalonDock:DockingManager.Theme>
                <themes:Vs2013LightTheme />
            </avalonDock:DockingManager.Theme>

            <avalonDock:LayoutRoot>
                <avalonDock:LayoutPanel Orientation="Horizontal">

                    <avalonDock:LayoutAnchorablePane DockWidth="220">
                        <avalonDock:LayoutAnchorable x:Name="SolutionExplorerAnchorable"
                                                      ContentId="{x:Static toolPanes:SolutionExplorerPaneViewModel.PaneContentId}"
                                                      Title="Solution Explorer"
                                                      CanClose="False" />
                    </avalonDock:LayoutAnchorablePane>

                    <avalonDock:LayoutPanel Orientation="Vertical">
                        <avalonDock:LayoutDocumentPane>
                            <avalonDock:LayoutDocument x:Name="WelcomeDocument"
                                                        ContentId="{x:Static local:WelcomeDocumentViewModel.ContentId}"
                                                        Title="Welcome"
                                                        CanClose="False" />
                        </avalonDock:LayoutDocumentPane>

                        <avalonDock:LayoutAnchorablePane DockHeight="180">
                            <avalonDock:LayoutAnchorable x:Name="OutputAnchorable"
                                                          ContentId="{x:Static toolPanes:OutputPaneViewModel.PaneContentId}"
                                                          Title="Output"
                                                          CanClose="False" />
                        </avalonDock:LayoutAnchorablePane>
                    </avalonDock:LayoutPanel>

                    <avalonDock:LayoutAnchorablePane DockWidth="320">
                        <avalonDock:LayoutAnchorable x:Name="CopilotChatAnchorable"
                                                      ContentId="{x:Static toolPanes:CopilotChatPaneViewModel.PaneContentId}"
                                                      Title="Copilot Chat"
                                                      CanClose="False" />
                    </avalonDock:LayoutAnchorablePane>

                </avalonDock:LayoutPanel>
            </avalonDock:LayoutRoot>
        </avalonDock:DockingManager>
    </Grid>
</Window>
