<UserControl x:Class="IdePlusPlus.Shell.Views.ScheduledAutomationsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:toolPanes="clr-namespace:IdePlusPlus.Shell.ToolPanes">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type toolPanes:ScheduleRowViewModel}">
            <Border Margin="0,2" Padding="6" CornerRadius="4"
                    Background="{DynamicResource EditProposalBackgroundBrush}"
                    BorderBrush="{DynamicResource EditProposalBorderBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding Enabled, Mode=OneWay}"
                                  Click="ScheduleEnabledCheckBox_OnClick"
                                  Tag="{Binding}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0"
                                  ToolTip="Enabled - unchecked schedules never fire" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Name}"
                                   FontWeight="Bold"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding TriggerDescription}"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Margin="4,0" />
                        <Button Grid.Column="3"
                                Content="Run now"
                                Click="RunNowButton_OnClick"
                                Tag="{Binding}"
                                Padding="6,0"
                                FontSize="10"
                                Margin="4,0,0,0" />
                        <Button Grid.Column="4"
                                Content="Delete"
                                Click="DeleteScheduleButton_OnClick"
                                Tag="{Binding}"
                                Padding="6,0"
                                FontSize="10"
                                Margin="4,0,0,0" />
                    </Grid>
                    <TextBlock Text="{Binding Prompt}"
                               FontSize="10"
                               TextWrapping="Wrap"
                               MaxHeight="48"
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource MutedForegroundBrush}" />
                    <TextBlock Text="{Binding LastRunDescription}"
                               FontSize="10"
                               FontStyle="Italic"
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource MutedForegroundBrush}" />
                    <TextBlock Text="{Binding LastResultSummary}"
                               FontSize="10"
                               TextWrapping="Wrap"
                               MaxHeight="64"
                               Margin="0,2,0,0"
                               Visibility="{Binding LastResultSummary, Converter={x:Static toolPanes:NullToVisibilityConverter.Instance}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="4">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <CheckBox Content="Scheduled automations enabled"
                      IsChecked="{Binding IsEnabled}"
                      FontSize="11"
                      ToolTip="Master switch - while off, nothing fires even if individual schedules are enabled" />
            <TextBlock Text="Runs while IDE++ is open, checking every minute. Each run is read-only - no edits, commands, builds or tests."
                       FontSize="10"
                       TextWrapping="Wrap"
                       Margin="0,2,0,0"
                       Foreground="{DynamicResource MutedForegroundBrush}" />
        </StackPanel>

        <Expander DockPanel.Dock="Bottom" Header="New schedule" Margin="0,6,0,0" IsExpanded="False">
            <StackPanel Margin="4">
                <TextBlock Text="Name" FontSize="10" Foreground="{DynamicResource MutedForegroundBrush}" />
                <TextBox Text="{Binding NewScheduleName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />

                <TextBlock Text="Prompt - what should it do each run?" FontSize="10" Foreground="{DynamicResource MutedForegroundBrush}" />
                <TextBox Text="{Binding NewSchedulePrompt, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="50"
                         Margin="0,0,0,4" />

                <TextBlock Text="Trigger" FontSize="10" Foreground="{DynamicResource MutedForegroundBrush}" />
                <ComboBox ItemsSource="{Binding AvailableTriggerKinds}"
                          SelectedItem="{Binding NewScheduleTriggerKind}"
                          Margin="0,0,0,4" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="Interval (hours)" FontSize="10" Foreground="{DynamicResource MutedForegroundBrush}" />
                        <TextBox Text="{Binding NewScheduleIntervalHoursText, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                    </StackPanel>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="Daily at (HH:mm)" FontSize="10" Foreground="{DynamicResource MutedForegroundBrush}" />
                        <TextBox Text="{Binding NewScheduleDailyTimeText, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="Only the field matching the trigger above is used."
                           FontSize="9"
                           FontStyle="Italic"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           Margin="0,0,0,4" />

                <Button Content="Add Schedule" Command="{Binding AddScheduleCommand}" HorizontalAlignment="Left" Padding="8,2" />
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Foreground="OrangeRed"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Expander>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Schedules}" />
        </ScrollViewer>
    </DockPanel>
</UserControl>
