<Window x:Class="IdePlusPlus.Shell.Views.StartupConfigurationManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:toolPanes="clr-namespace:IdePlusPlus.Shell.ToolPanes"
        Title="Startup Configuration Manager"
        Width="760"
        Height="540"
        MinWidth="620"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextElement.Foreground="{DynamicResource WindowForegroundBrush}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Configurations:" Margin="0,0,0,4" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="New" Command="{Binding NewConfigurationCommand}" Padding="8,2" />
                    <Button Content="Duplicate" Command="{Binding DuplicateConfigurationCommand}" Margin="6,0,0,0" Padding="8,2" />
                    <Button Content="Delete" Command="{Binding DeleteConfigurationCommand}" Margin="6,0,0,0" Padding="8,2" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Configurations}"
                         SelectedItem="{Binding SelectedConfiguration}"
                         Background="{DynamicResource PanelBackgroundBrush}"
                         BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type toolPanes:StartupConfigurationEditorViewModel}">
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <RadioButton GroupName="ActiveStartupConfiguration"
                                             IsChecked="{Binding IsActive}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,6,0"
                                             ToolTip="Active configuration - the one Run/Start Debugging use" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <DockPanel Grid.Column="2" DataContext="{Binding SelectedConfiguration}">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" />
                </Grid>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Project" FontWeight="Bold" />
                    <TextBlock Grid.Column="1" Text="Action" FontWeight="Bold" Margin="4,0" />
                    <TextBlock Grid.Column="2" Text="Launch profile" FontWeight="Bold" Margin="4,0" />
                </Grid>

                <ListBox ItemsSource="{Binding Rows}"
                         Background="{DynamicResource PanelBackgroundBrush}"
                         BorderThickness="1"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type toolPanes:StartupConfigurationEntryRowViewModel}">
                            <Grid Margin="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="26" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding ProjectName}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ProjectExistsInSolution}" Value="False">
                                                    <Setter Property="Text" Value="{Binding ProjectName, StringFormat='{}{0} (missing)'}" />
                                                    <Setter Property="Opacity" Value="0.5" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableActions}"
                                          SelectedItem="{Binding Action}"
                                          Margin="4,1"
                                          IsEnabled="{Binding ProjectExistsInSolution}" />
                                <ComboBox Grid.Column="2"
                                          ItemsSource="{Binding AvailableLaunchProfileDisplayNames}"
                                          SelectedItem="{Binding SelectedLaunchProfileDisplayName}"
                                          Margin="4,1"
                                          IsEnabled="{Binding ProjectExistsInSolution}" />
                                <Button Grid.Column="3"
                                        Content="&#9650;"
                                        Padding="0"
                                        ToolTip="Move up"
                                        Command="{Binding DataContext.MoveRowUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                                <Button Grid.Column="4"
                                        Content="&#9660;"
                                        Padding="0"
                                        Margin="2,0,0,0"
                                        ToolTip="Move down"
                                        Command="{Binding DataContext.MoveRowDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Click="OkButton_OnClick" Padding="12,4" IsDefault="True" />
            <Button Content="Cancel" Click="CancelButton_OnClick" Margin="8,0,0,0" Padding="12,4" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
