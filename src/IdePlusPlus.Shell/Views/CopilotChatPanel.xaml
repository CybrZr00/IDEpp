<UserControl x:Class="IdePlusPlus.Shell.Views.CopilotChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:toolPanes="clr-namespace:IdePlusPlus.Shell.ToolPanes"
             xmlns:mdxam="clr-namespace:MdXaml;assembly=MdXaml">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type toolPanes:ChatMessageViewModel}">
            <Border Margin="4" Padding="6" CornerRadius="4" MaxWidth="340">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource ChatBubbleAssistantBackgroundBrush}" />
                        <Setter Property="HorizontalAlignment" Value="Left" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ChatBubbleUserBackgroundBrush}" />
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Button Content="⧉"
                            HorizontalAlignment="Right"
                            Width="18"
                            Height="18"
                            Padding="0"
                            Margin="0,0,0,2"
                            FontSize="10"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Tag="{Binding}"
                            Click="CopyBubbleText_OnClick"
                            ToolTip="Copy message" />

                    <!-- The model's reasoning trace (only present when Effort is above None and the
                         provider streams one) - collapsed by default since it's a working trace, not
                         the answer itself, but there for anyone who wants to see why the assistant
                         did what it did rather than just watching it appear to sit idle. -->
                    <Expander Header="💭 Reasoning"
                              IsExpanded="False"
                              FontSize="11"
                              Margin="0,0,0,4"
                              Visibility="{Binding HasReasoning, Converter={x:Static toolPanes:BoolToVisibilityConverter.Instance}}">
                        <TextBox Text="{Binding ReasoningText, Mode=OneWay}"
                                 TextWrapping="Wrap"
                                 FontStyle="Italic"
                                 FontSize="11"
                                 Foreground="{DynamicResource MutedForegroundBrush}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 IsReadOnly="True"
                                 Margin="4,4,0,0" />
                    </Expander>

                    <!-- MdXaml's built-in "SasabuneCompact" style derives every color (headings, code
                         block/span background+foreground, table rules, etc.) from this control's own
                         Foreground/Background via the mde:Alpha/mde:Brightness markup extensions - not
                         from the OS theme - so it follows this app's own Dark/Light toggle correctly as
                         long as those two properties are set to match the bubble around it. -->
                    <mdxam:MarkdownScrollViewer Markdown="{Binding Text}"
                                                MarkdownStyleName="SasabuneCompact"
                                                Foreground="{DynamicResource WindowForegroundBrush}"
                                                BorderThickness="0"
                                                Padding="0"
                                                VerticalScrollBarVisibility="Disabled"
                                                HorizontalScrollBarVisibility="Disabled">
                        <mdxam:MarkdownScrollViewer.Style>
                            <Style TargetType="mdxam:MarkdownScrollViewer">
                                <Setter Property="Background" Value="{DynamicResource ChatBubbleAssistantBackgroundBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ChatBubbleUserBackgroundBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </mdxam:MarkdownScrollViewer.Style>
                    </mdxam:MarkdownScrollViewer>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Deliberately its own visual identity (violet accent, no left/right alignment split) so
             an adversarial review reads as a second voice looking at the work, not the primary
             agent talking about itself the way a ChatMessageViewModel bubble would. -->
        <DataTemplate DataType="{x:Type toolPanes:ReviewMessageViewModel}">
            <Border Margin="4"
                    Padding="8"
                    CornerRadius="4"
                    Background="{DynamicResource ReviewBackgroundBrush}"
                    BorderBrush="{DynamicResource ReviewBorderBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Left"
                    MaxWidth="480">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right"
                                Content="⧉"
                                Width="18"
                                Height="18"
                                Padding="0"
                                FontSize="10"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Tag="{Binding}"
                                Click="CopyBubbleText_OnClick"
                                ToolTip="Copy message" />
                        <TextBlock Text="🔍 Independent review"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource MutedForegroundBrush}" />
                    </DockPanel>
                    <mdxam:MarkdownScrollViewer Markdown="{Binding Text}"
                                                MarkdownStyleName="SasabuneCompact"
                                                Foreground="{DynamicResource WindowForegroundBrush}"
                                                Background="{DynamicResource ReviewBackgroundBrush}"
                                                BorderThickness="0"
                                                Padding="0"
                                                VerticalScrollBarVisibility="Disabled"
                                                HorizontalScrollBarVisibility="Disabled" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type toolPanes:EditProposalViewModel}">
            <Border Margin="4"
                    Padding="8"
                    CornerRadius="4"
                    Background="{DynamicResource EditProposalBackgroundBrush}"
                    BorderBrush="{DynamicResource EditProposalBorderBrush}"
                    BorderThickness="1"
                    MaxWidth="320">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="⧉"
                                Width="18"
                                Height="18"
                                Padding="0"
                                FontSize="10"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Tag="{Binding}"
                                Click="CopyBubbleText_OnClick"
                                ToolTip="Copy edit summary" />
                        <TextBlock Text="{Binding FilePath}" FontWeight="Bold" TextWrapping="Wrap" />
                    </DockPanel>

                    <TextBox Text="{Binding PreviewText, Mode=OneWay}"
                             FontFamily="Consolas"
                             FontSize="11"
                             TextWrapping="Wrap"
                             MaxHeight="120"
                             IsReadOnly="True"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             Visibility="{Binding IsComplete, Converter={x:Static toolPanes:InverseBoolToVisibilityConverter.Instance}}" />

                    <TextBox Text="{Binding ChangeSummary, Mode=OneWay}"
                             Margin="0,2,0,4"
                             Padding="3,1"
                             FontFamily="Consolas"
                             FontSize="11"
                             IsReadOnly="True"
                             BorderThickness="0"
                             Visibility="{Binding IsComplete, Converter={x:Static toolPanes:BoolToVisibilityConverter.Instance}}">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLargeDeletion}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DiffRemovedBackgroundBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- The diff itself and Accept/Reject now live in the editor tab this proposal's
                         file was opened/focused in (see TextEditorHost's diff review panel) - this
                         card stays a compact status line so the chat scrollback doesn't repeat it. -->
                    <TextBlock Text="{Binding StatusText}"
                               Margin="0,2,0,0"
                               FontStyle="Italic"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedForegroundBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type toolPanes:PlanProposalViewModel}">
            <Border Margin="4"
                    Padding="8"
                    CornerRadius="4"
                    Background="{DynamicResource EditProposalBackgroundBrush}"
                    BorderBrush="{DynamicResource EditProposalBorderBrush}"
                    BorderThickness="1"
                    MaxWidth="320">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="⧉"
                                Width="18"
                                Height="18"
                                Padding="0"
                                FontSize="10"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Tag="{Binding}"
                                Click="CopyBubbleText_OnClick"
                                ToolTip="Copy plan" />
                        <TextBlock Text="{Binding Summary}" FontWeight="Bold" TextWrapping="Wrap" />
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding Steps}"
                                  Visibility="{Binding IsComplete, Converter={x:Static toolPanes:BoolToVisibilityConverter.Instance}}"
                                  Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,6,0,0"
                                Visibility="{Binding IsDecided, Converter={x:Static toolPanes:InverseBoolToVisibilityConverter.Instance}}">
                        <Button Content="Approve &amp; Implement" Command="{Binding ApproveCommand}" Padding="8,2" />
                        <Button Content="Reject" Command="{Binding RejectCommand}" Margin="6,0,0,0" Padding="8,2" />
                    </StackPanel>

                    <TextBlock Text="{Binding DecisionText}"
                               Margin="0,6,0,0"
                               FontStyle="Italic"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               Visibility="{Binding IsDecided, Converter={x:Static toolPanes:BoolToVisibilityConverter.Instance}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type toolPanes:McpToolCallViewModel}">
            <Border Margin="4"
                    Padding="6"
                    CornerRadius="4"
                    Background="{DynamicResource EditProposalBackgroundBrush}"
                    BorderBrush="{DynamicResource EditProposalBorderBrush}"
                    BorderThickness="1"
                    MaxWidth="320">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="⧉"
                                Width="18"
                                Height="18"
                                Padding="0"
                                FontSize="10"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Tag="{Binding}"
                                Click="CopyBubbleText_OnClick"
                                ToolTip="Copy tool result" />
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="🔧" />
                            <Run Text="{Binding ToolName, Mode=OneWay}" FontWeight="Bold" FontFamily="Consolas" FontSize="11" />
                            <Run Text="—" />
                            <Run Text="{Binding Status, Mode=OneWay}" FontStyle="Italic" />
                        </TextBlock>
                    </DockPanel>
                    <TextBox Text="{Binding ResultPreview, Mode=OneWay}"
                             FontFamily="Consolas"
                             FontSize="10"
                             TextWrapping="Wrap"
                             MaxHeight="160"
                             Margin="0,2,0,0"
                             IsReadOnly="True"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             Foreground="{DynamicResource MutedForegroundBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,4,4,4">
            <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding AvailableProviders}"
                          SelectedItem="{Binding SelectedProvider}"
                          Width="90"
                          FontSize="11" />
                <ComboBox ItemsSource="{Binding AvailableModels}"
                          Text="{Binding SelectedModel, UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="True"
                          Width="190"
                          FontSize="11"
                          Margin="4,0,0,0"
                          ToolTip="Model to chat with. Type to filter, or enter any model id the provider accepts - the list shows tool-capable models, since editing files needs tool support." />
                <Button Content="⟳"
                        Command="{Binding RefreshModelsCommand}"
                        ToolTip="Refresh the model list from the selected provider"
                        Width="24"
                        Margin="4,0,0,0"
                        Padding="0" />
            </StackPanel>
            <TextBlock Text="Fetching models…"
                       FontSize="10"
                       Foreground="{DynamicResource MutedForegroundBrush}"
                       Visibility="{Binding IsRefreshingModels, Converter={x:Static toolPanes:BoolToVisibilityConverter.Instance}}" />
            <CheckBox Content="Include current file"
                      IsChecked="{Binding IncludeCurrentFileContext}"
                      Margin="0,4,0,0"
                      FontSize="11" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="4,0,4,4">
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="Use codebase search"
                          IsChecked="{Binding UseCodebaseSearch}"
                          VerticalAlignment="Center"
                          FontSize="11" />
                <Button Content="Index Codebase" Command="{Binding IndexCodebaseCommand}" Margin="8,0,0,0" Padding="6,0" />
                <Button Content="Save Memory" Command="{Binding SaveMemoryCommand}" Margin="4,0,0,0" Padding="6,0" />
                <Button Content="Review"
                        Command="{Binding ReviewLastChangeCommand}"
                        Margin="4,0,0,0"
                        Padding="6,0"
                        ToolTip="Sends the current uncommitted diff to a fresh, independent model call for a second opinion" />
            </StackPanel>
            <TextBlock Text="{Binding IndexStatus}"
                       Margin="0,2,0,0"
                       Foreground="{DynamicResource MutedForegroundBrush}"
                       FontSize="10"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="4,0,4,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Effort" VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0" />
                <ComboBox ItemsSource="{Binding AvailableEfforts}"
                          SelectedItem="{Binding SelectedEffort}"
                          Width="70"
                          FontSize="11" />
                <CheckBox Content="Plan Mode"
                          IsChecked="{Binding IsPlanMode}"
                          VerticalAlignment="Center"
                          FontSize="11"
                          Margin="12,0,0,0"
                          ToolTip="Investigates and proposes a plan for approval before touching any files" />
                <CheckBox Content="Auto Mode"
                          IsChecked="{Binding IsAutoMode}"
                          VerticalAlignment="Center"
                          FontSize="11"
                          Margin="12,0,0,0"
                          ToolTip="Accepts edit proposals automatically instead of waiting for Accept/Reject" />
                <CheckBox Content="Shell"
                          IsChecked="{Binding AreShellCommandsEnabled}"
                          VerticalAlignment="Center"
                          FontSize="11"
                          Margin="12,0,0,0"
                          ToolTip="Lets the assistant propose PowerShell commands. You confirm each distinct command before it runs." />
                <CheckBox Content="Web"
                          IsChecked="{Binding AreWebFetchEnabled}"
                          VerticalAlignment="Center"
                          FontSize="11"
                          Margin="12,0,0,0"
                          ToolTip="Lets the assistant fetch public webpages. You confirm each new host before it's fetched." />
            </StackPanel>
            <TextBlock Text="📝 Plan Mode is on - investigating and proposing a plan, no edits yet"
                       FontSize="10"
                       Foreground="{DynamicResource MutedForegroundBrush}"
                       Margin="0,2,0,0"
                       TextWrapping="Wrap"
                       Visibility="{Binding IsPlanMode, Converter={x:Static toolPanes:BoolToVisibilityConverter.Instance}}" />
            <TextBlock Text="⚡ Auto Mode is on - edits are applied automatically, without review"
                       FontSize="10"
                       Foreground="OrangeRed"
                       Margin="0,2,0,0"
                       TextWrapping="Wrap"
                       Visibility="{Binding IsAutoMode, Converter={x:Static toolPanes:BoolToVisibilityConverter.Instance}}" />
            <TextBlock Text="⚠ Shell is on - the assistant can propose commands to run on this machine. You confirm each one."
                       FontSize="10"
                       Foreground="OrangeRed"
                       Margin="0,2,0,0"
                       TextWrapping="Wrap"
                       Visibility="{Binding AreShellCommandsEnabled, Converter={x:Static toolPanes:BoolToVisibilityConverter.Instance}}" />
            <TextBlock Text="🌐 Web is on - the assistant can fetch public webpages. You confirm each new host."
                       FontSize="10"
                       Foreground="OrangeRed"
                       Margin="0,2,0,0"
                       TextWrapping="Wrap"
                       Visibility="{Binding AreWebFetchEnabled, Converter={x:Static toolPanes:BoolToVisibilityConverter.Instance}}" />

            <!-- The one thing that actually answers "is it still working, or has it silently died?" -
                 an indeterminate spinner plus what it's doing right now, visible for the whole
                 duration of a turn (including a multi-iteration tool loop), not just the first
                 response chunk. -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,4,0,0"
                        Visibility="{Binding IsStreaming, Converter={x:Static toolPanes:BoolToVisibilityConverter.Instance}}">
                <ProgressBar IsIndeterminate="True" Width="16" Height="16" Margin="0,0,6,0" />
                <TextBlock Text="{Binding CurrentActivity}" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="3" x:Name="MessagesScrollViewer" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Messages}" />
        </ScrollViewer>

        <Grid Grid.Row="4" Margin="4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedForegroundBrush}"
                       FontSize="11" />
            <TextBlock Grid.Column="1"
                       Text="{Binding TokenUsageText}"
                       Margin="8,0,0,0"
                       Foreground="{DynamicResource MutedForegroundBrush}"
                       FontSize="10"
                       ToolTip="Cumulative tokens billed this session (every request re-sends the full conversation)" />
        </Grid>

        <Grid Grid.Row="5" Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MaxHeight="80"
                     VerticalScrollBarVisibility="Auto"
                     PreviewKeyDown="InputTextBox_OnKeyDown" />
            <Button Grid.Column="1" Content="Send" Command="{Binding SendCommand}" Margin="4,0,0,0" Padding="10,0" />
        </Grid>
    </Grid>
</UserControl>
