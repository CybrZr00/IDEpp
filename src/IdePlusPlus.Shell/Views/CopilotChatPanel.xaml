<UserControl x:Class="IdePlusPlus.Shell.Views.CopilotChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:toolPanes="clr-namespace:IdePlusPlus.Shell.ToolPanes"
             xmlns:diff="clr-namespace:IdePlusPlus.Copilot.Diff;assembly=IdePlusPlus.Copilot.Diff"
             xmlns:mdxam="clr-namespace:MdXaml;assembly=MdXaml">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type toolPanes:ChatMessageViewModel}">
            <Border Margin="4" Padding="6" CornerRadius="4" MaxWidth="340">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource ChatBubbleAssistantBackgroundBrush}" />
                        <Setter Property="HorizontalAlignment" Value="Left" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ChatBubbleUserBackgroundBrush}" />
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <!-- MdXaml's built-in "SasabuneCompact" style derives every color (headings, code
                     block/span background+foreground, table rules, etc.) from this control's own
                     Foreground/Background via the mde:Alpha/mde:Brightness markup extensions - not
                     from the OS theme - so it follows this app's own Dark/Light toggle correctly as
                     long as those two properties are set to match the bubble around it. -->
                <mdxam:MarkdownScrollViewer Markdown="{Binding Text}"
                                            MarkdownStyleName="SasabuneCompact"
                                            Foreground="{DynamicResource WindowForegroundBrush}"
                                            BorderThickness="0"
                                            Padding="0"
                                            VerticalScrollBarVisibility="Disabled"
                                            HorizontalScrollBarVisibility="Disabled">
                    <mdxam:MarkdownScrollViewer.Style>
                        <Style TargetType="mdxam:MarkdownScrollViewer">
                            <Setter Property="Background" Value="{DynamicResource ChatBubbleAssistantBackgroundBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ChatBubbleUserBackgroundBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </mdxam:MarkdownScrollViewer.Style>
                </mdxam:MarkdownScrollViewer>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type diff:DiffLine}">
            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Added">
                                <Setter Property="Background" Value="{DynamicResource DiffAddedBackgroundBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                <Setter Property="Background" Value="{DynamicResource DiffRemovedBackgroundBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap">
                    <Run Text="{Binding Kind, Mode=OneWay, Converter={x:Static toolPanes:DiffLinePrefixConverter.Instance}}" FontWeight="Bold" />
                    <Run Text="{Binding Text, Mode=OneWay}" />
                </TextBlock>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type toolPanes:EditProposalViewModel}">
            <Border Margin="4"
                    Padding="8"
                    CornerRadius="4"
                    Background="{DynamicResource EditProposalBackgroundBrush}"
                    BorderBrush="{DynamicResource EditProposalBorderBrush}"
                    BorderThickness="1"
                    MaxWidth="320">
                <StackPanel>
                    <TextBlock Text="{Binding FilePath}" FontWeight="Bold" TextWrapping="Wrap" />

                    <TextBlock Text="{Binding PreviewText}"
                               FontFamily="Consolas"
                               FontSize="11"
                               TextWrapping="Wrap"
                               MaxHeight="120"
                               Visibility="{Binding IsComplete, Converter={x:Static toolPanes:InverseBoolToVisibilityConverter.Instance}}" />

                    <ItemsControl ItemsSource="{Binding DiffLines}"
                                  Visibility="{Binding IsComplete, Converter={x:Static toolPanes:BoolToVisibilityConverter.Instance}}"
                                  MaxHeight="240" />

                    <StackPanel Orientation="Horizontal"
                                Margin="0,6,0,0"
                                Visibility="{Binding IsDecided, Converter={x:Static toolPanes:InverseBoolToVisibilityConverter.Instance}}">
                        <Button Content="Accept" Command="{Binding AcceptCommand}" Padding="8,2" />
                        <Button Content="Reject" Command="{Binding RejectCommand}" Margin="6,0,0,0" Padding="8,2" />
                    </StackPanel>

                    <TextBlock Text="{Binding DecisionText}"
                               Margin="0,6,0,0"
                               FontStyle="Italic"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               Visibility="{Binding IsDecided, Converter={x:Static toolPanes:BoolToVisibilityConverter.Instance}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type toolPanes:McpToolCallViewModel}">
            <Border Margin="4"
                    Padding="6"
                    CornerRadius="4"
                    Background="{DynamicResource EditProposalBackgroundBrush}"
                    BorderBrush="{DynamicResource EditProposalBorderBrush}"
                    BorderThickness="1"
                    MaxWidth="320">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="🔧" />
                        <Run Text="{Binding ToolName, Mode=OneWay}" FontWeight="Bold" FontFamily="Consolas" FontSize="11" />
                        <Run Text="—" />
                        <Run Text="{Binding Status, Mode=OneWay}" FontStyle="Italic" />
                    </TextBlock>
                    <TextBlock Text="{Binding ResultPreview}"
                               FontFamily="Consolas"
                               FontSize="10"
                               TextWrapping="Wrap"
                               MaxHeight="160"
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource MutedForegroundBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,4,4,4">
            <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding AvailableProviders}"
                          SelectedItem="{Binding SelectedProvider}"
                          Width="90"
                          FontSize="11" />
                <ComboBox ItemsSource="{Binding AvailableModels}"
                          Text="{Binding SelectedModel, UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="True"
                          Width="120"
                          FontSize="11"
                          Margin="4,0,0,0" />
                <Button Content="⟳"
                        Command="{Binding RefreshLmStudioModelsCommand}"
                        Visibility="{Binding IsLmStudioProvider, Converter={x:Static toolPanes:BoolToVisibilityConverter.Instance}}"
                        ToolTip="Refresh model list from LM Studio"
                        Width="24"
                        Margin="4,0,0,0"
                        Padding="0" />
            </StackPanel>
            <TextBlock Text="Fetching models…"
                       FontSize="10"
                       Foreground="{DynamicResource MutedForegroundBrush}"
                       Visibility="{Binding IsRefreshingModels, Converter={x:Static toolPanes:BoolToVisibilityConverter.Instance}}" />
            <CheckBox Content="Include current file"
                      IsChecked="{Binding IncludeCurrentFileContext}"
                      Margin="0,4,0,0"
                      FontSize="11" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="4,0,4,4">
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="Use codebase search"
                          IsChecked="{Binding UseCodebaseSearch}"
                          VerticalAlignment="Center"
                          FontSize="11" />
                <Button Content="Index Codebase" Command="{Binding IndexCodebaseCommand}" Margin="8,0,0,0" Padding="6,0" />
                <Button Content="Save Memory" Command="{Binding SaveMemoryCommand}" Margin="4,0,0,0" Padding="6,0" />
            </StackPanel>
            <TextBlock Text="{Binding IndexStatus}"
                       Margin="0,2,0,0"
                       Foreground="{DynamicResource MutedForegroundBrush}"
                       FontSize="10"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" x:Name="MessagesScrollViewer" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Messages}" />
        </ScrollViewer>

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   Margin="4,0"
                   Foreground="{DynamicResource MutedForegroundBrush}"
                   FontSize="11" />

        <Grid Grid.Row="4" Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MaxHeight="80"
                     VerticalScrollBarVisibility="Auto"
                     PreviewKeyDown="InputTextBox_OnKeyDown" />
            <Button Grid.Column="1" Content="Send" Command="{Binding SendCommand}" Margin="4,0,0,0" Padding="10,0" />
        </Grid>
    </Grid>
</UserControl>
