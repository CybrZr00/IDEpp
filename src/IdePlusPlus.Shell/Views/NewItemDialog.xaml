<Window x:Class="IdePlusPlus.Shell.Views.NewItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:templates="clr-namespace:IdePlusPlus.Templates;assembly=IdePlusPlus.Templates"
        Title="New Item"
        Width="820"
        Height="560"
        MinWidth="680"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Loaded="NewItemDialog_OnLoaded"
        Closing="NewItemDialog_OnClosing"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextElement.Foreground="{DynamicResource WindowForegroundBrush}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Row="0" Grid.Column="0">
            <TextBox DockPanel.Dock="Top"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                     Padding="4,3"
                     Margin="0,0,0,6"
                     ToolTip="Searches names, short names, descriptions and tags" />
            <ListBox ItemsSource="{Binding Templates}"
                     SelectedItem="{Binding SelectedTemplate}"
                     Background="{DynamicResource PanelBackgroundBrush}"
                     Foreground="{DynamicResource WindowForegroundBrush}"
                     BorderThickness="1"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type templates:TemplateGroup}">
                        <StackPanel Margin="2,3">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Description}"
                                       FontSize="10"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource MutedForegroundBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Grid Grid.Row="0" Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="{Binding SelectedTemplate.Description}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"
                       Foreground="{DynamicResource MutedForegroundBrush}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,0,6,6" />
            <TextBox Grid.Row="1" Grid.Column="1"
                     x:Name="NameTextBox"
                     Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}"
                     Padding="4,2" Margin="0,0,0,6" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Folder:" VerticalAlignment="Center" Margin="0,0,6,6" />
            <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,6">
                <Button DockPanel.Dock="Right"
                        Content="Browse..."
                        Click="BrowseButton_OnClick"
                        Margin="6,0,0,0"
                        Padding="8,2" />
                <TextBox Text="{Binding Directory, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" />
            </DockPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Language:" VerticalAlignment="Center" Margin="0,0,6,6" />
            <ComboBox Grid.Row="3" Grid.Column="1"
                      ItemsSource="{Binding Languages}"
                      SelectedItem="{Binding SelectedLanguage}"
                      Margin="0,0,0,6" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Namespace:" VerticalAlignment="Center" Margin="0,0,6,6" />
            <TextBlock Grid.Row="4" Grid.Column="1"
                       Text="{Binding ResolvedNamespace}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       FontFamily="Consolas"
                       Foreground="{DynamicResource MutedForegroundBrush}"
                       ToolTip="Taken from the project's root namespace and the folder the file goes in" />
        </Grid>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0">
            <TextBlock Text="{Binding TargetSummary}"
                       TextTrimming="CharacterEllipsis"
                       FontSize="11"
                       Foreground="{DynamicResource MutedForegroundBrush}" />
            <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource MutedForegroundBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Add" Command="{Binding CreateCommand}" Padding="12,4" IsDefault="True" />
            <Button Content="Cancel" Click="CancelButton_OnClick" Margin="8,0,0,0" Padding="12,4" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
