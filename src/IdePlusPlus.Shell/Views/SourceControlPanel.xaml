<UserControl x:Class="IdePlusPlus.Shell.Views.SourceControlPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:diff="clr-namespace:IdePlusPlus.Copilot.Diff;assembly=IdePlusPlus.Copilot.Diff"
             xmlns:sourceControl="clr-namespace:IdePlusPlus.SourceControl;assembly=IdePlusPlus.SourceControl"
             xmlns:toolPanes="clr-namespace:IdePlusPlus.Shell.ToolPanes">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type diff:DiffLine}">
            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Added">
                                <Setter Property="Background" Value="{DynamicResource DiffAddedBackgroundBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                <Setter Property="Background" Value="{DynamicResource DiffRemovedBackgroundBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Kind, Mode=OneWay, Converter={x:Static toolPanes:DiffLinePrefixConverter.Instance}}"
                               FontWeight="Bold"
                               FontFamily="Consolas"
                               FontSize="11" />
                    <TextBlock Text="{Binding Text, Mode=OneWay}"
                               FontFamily="Consolas"
                               FontSize="11"
                               Visibility="{Binding HasSegments, Converter={x:Static toolPanes:InverseBoolToVisibilityConverter.Instance}}" />
                    <ItemsControl ItemsSource="{Binding Segments}"
                                  Visibility="{Binding HasSegments, Converter={x:Static toolPanes:BoolToVisibilityConverter.Instance}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type diff:DiffTextSegment}">
                                <TextBlock Text="{Binding Text, Mode=OneWay}" FontFamily="Consolas" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource DiffHighlightBackgroundBrush}" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type sourceControl:GitFileChange}">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Path}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Margin="2,0" />
                <Button Grid.Column="1"
                        Click="StageOrUnstageButton_OnClick"
                        Tag="{Binding}"
                        Padding="6,0"
                        FontSize="10">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="Stage" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStaged}" Value="True">
                                    <Setter Property="Content" Value="Unstage" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="4">
        <TextBlock Text="Not a git repository."
                   Foreground="{DynamicResource MutedForegroundBrush}"
                   Margin="2"
                   VerticalAlignment="Top"
                   Visibility="{Binding IsGitRepository, Converter={x:Static toolPanes:InverseBoolToVisibilityConverter.Instance}}" />

        <Grid Visibility="{Binding IsGitRepository, Converter={x:Static toolPanes:BoolToVisibilityConverter.Instance}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="{Binding BranchStatusText}" FontWeight="Bold" VerticalAlignment="Center" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="8,0,0,0" Padding="6,0" FontSize="11" />
                <Button Content="Fetch" Command="{Binding FetchCommand}" Margin="4,0,0,0" Padding="6,0" FontSize="11" />
                <Button Content="Pull" Command="{Binding PullCommand}" Margin="4,0,0,0" Padding="6,0" FontSize="11" />
                <Button Content="Push" Command="{Binding PushCommand}" Margin="4,0,0,0" Padding="6,0" FontSize="11" />
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                <ComboBox x:Name="BranchComboBox"
                          ItemsSource="{Binding Branches}"
                          DisplayMemberPath="Name"
                          Width="140"
                          FontSize="11" />
                <Button Content="Checkout" Click="CheckoutButton_OnClick" Margin="4,0,0,0" Padding="6,0" FontSize="11" />
            </StackPanel>

            <TextBlock Grid.Row="2" Text="Staged Changes" FontWeight="Bold" FontSize="11" Margin="0,0,0,2" />
            <ListBox Grid.Row="3"
                     ItemsSource="{Binding StagedFiles}"
                     SelectedItem="{Binding SelectedFile}"
                     MaxHeight="120"
                     BorderThickness="0"
                     Background="{DynamicResource PanelBackgroundBrush}" />

            <TextBlock Grid.Row="4" Text="Changes" FontWeight="Bold" FontSize="11" Margin="0,6,0,2" />
            <ListBox Grid.Row="5"
                     ItemsSource="{Binding UnstagedFiles}"
                     SelectedItem="{Binding SelectedFile}"
                     MaxHeight="120"
                     BorderThickness="0"
                     Background="{DynamicResource PanelBackgroundBrush}" />

            <Grid Grid.Row="6" Margin="0,6,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MaxHeight="50"
                         FontSize="11" />
                <Button Grid.Column="1"
                        Content="Commit All"
                        Command="{Binding CommitAllCommand}"
                        Margin="4,0,0,0"
                        Padding="8,0"
                        ToolTip="Stage every change and commit, without staging files individually first - like Visual Studio's Git Changes window." />
                <Button Grid.Column="2"
                        Content="Commit"
                        Command="{Binding CommitCommand}"
                        Margin="4,0,0,0"
                        Padding="8,0"
                        ToolTip="Commit only what's already staged." />
            </Grid>

            <TextBlock Grid.Row="7"
                       Text="Diff"
                       FontWeight="Bold"
                       FontSize="11"
                       Margin="0,2,0,2"
                       VerticalAlignment="Top" />
            <ScrollViewer Grid.Row="7" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
                <ItemsControl ItemsSource="{Binding DiffLines}" />
            </ScrollViewer>

            <TextBlock Grid.Row="8"
                       Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource MutedForegroundBrush}"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />
        </Grid>
    </Grid>
</UserControl>
