<Window x:Class="IdePlusPlus.Shell.Views.AddPackageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nuget="clr-namespace:IdePlusPlus.NuGet;assembly=IdePlusPlus.NuGet"
        xmlns:toolPanes="clr-namespace:IdePlusPlus.Shell.ToolPanes"
        Title="Add Package"
        Width="520"
        Height="480"
        MinWidth="420"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextElement.Foreground="{DynamicResource WindowForegroundBrush}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchTextBox"
                     Grid.Column="0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="SearchTextBox_OnKeyDown" />
            <Button Grid.Column="1" Content="Search" Command="{Binding SearchCommand}" Margin="6,0,0,0" Padding="10,2" />
        </Grid>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Results}"
                 SelectedItem="{Binding SelectedResult}"
                 Background="{DynamicResource PanelBackgroundBrush}"
                 BorderThickness="1"
                 MouseDoubleClick="ResultsListBox_OnMouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type nuget:NuGetSearchResult}">
                    <StackPanel Margin="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Id}" FontWeight="Bold" />
                            <TextBlock Text="{Binding LatestVersion}" Margin="6,0,0,0" Foreground="{DynamicResource MutedForegroundBrush}" />
                            <TextBlock Margin="10,0,0,0" FontSize="10" Foreground="{DynamicResource MutedForegroundBrush}">
                                <Run Text="{Binding TotalDownloads, Mode=OneWay, StringFormat={}{0:N0}}" />
                                <Run Text=" downloads" />
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedForegroundBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2"
                   Text="Searching..."
                   FontSize="11"
                   Foreground="{DynamicResource MutedForegroundBrush}"
                   Margin="0,4,0,0"
                   Visibility="{Binding IsSearching, Converter={x:Static toolPanes:BoolToVisibilityConverter.Instance}}" />

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedForegroundBrush}"
                   Margin="0,4,0,0" />

        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Version (optional, blank = latest):" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Text="{Binding SelectedVersion, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Install" Click="InstallButton_OnClick" Padding="12,4" IsDefault="True" />
            <Button Content="Cancel" Click="CancelButton_OnClick" Margin="8,0,0,0" Padding="12,4" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
