<Window x:Class="IdePlusPlus.Shell.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextElement.Foreground="{DynamicResource WindowForegroundBrush}">

    <StackPanel Margin="16">
        <TextBlock Text="Copilot" FontWeight="Bold" Margin="0,0,0,8" />

        <TextBlock Text="OpenRouter API key (chat):" Margin="0,0,0,2" />
        <DockPanel Margin="0,0,0, 4">
            <Button DockPanel.Dock="Right" Content="Save" Padding="10,2" Margin="6,0,0,0" Click="SaveApiKeyButton_OnClick" />
            <PasswordBox x:Name="ApiKeyBox" />
        </DockPanel>
        <TextBlock Text="{Binding ApiKeyStatusText}"
                   Foreground="{DynamicResource MutedForegroundBrush}"
                   FontSize="11"
                   Margin="0,0,0,12" />

        <TextBlock Text="DeepSeek API key (inline completion):" Margin="0,0,0,2" />
        <DockPanel Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Content="Save" Padding="10,2" Margin="6,0,0,0" Click="SaveDeepSeekApiKeyButton_OnClick" />
            <PasswordBox x:Name="DeepSeekApiKeyBox" />
        </DockPanel>
        <TextBlock Text="{Binding DeepSeekApiKeyStatusText}"
                   Foreground="{DynamicResource MutedForegroundBrush}"
                   FontSize="11"
                   Margin="0,0,0,16" />

        <TextBlock Text="Codebase Search" FontWeight="Bold" Margin="0,0,0,8" />

        <TextBlock Text="LM Studio base URL:" Margin="0,0,0,2" />
        <TextBox Text="{Binding LmStudioBaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

        <TextBlock Text="Embedding model name (as loaded in LM Studio):" Margin="0,0,0,2" />
        <TextBox Text="{Binding LmStudioModel, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,8"
                 ToolTip="e.g. text-embedding-nomic-embed-text-v1.5" />

        <Button Content="Save LM Studio Settings" Command="{Binding SaveLmStudioSettingsCommand}" HorizontalAlignment="Left" Padding="10,4" />

        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,16,0,0" />

        <Button Content="Close" Padding="12,4" Margin="0,16,0,0" HorizontalAlignment="Right" Click="CloseButton_OnClick" />
    </StackPanel>
</Window>
