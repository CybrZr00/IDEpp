<Window x:Class="IdePlusPlus.Shell.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="460"
        Height="640"
        MinWidth="420"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextElement.Foreground="{DynamicResource WindowForegroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="Copilot" FontWeight="Bold" Margin="0,0,0,8" />

            <TextBlock Text="OpenRouter API key (chat):" Margin="0,0,0,2" />
            <DockPanel Margin="0,0,0, 4">
                <Button DockPanel.Dock="Right" Content="Save" Padding="10,2" Margin="6,0,0,0" Click="SaveApiKeyButton_OnClick" />
                <PasswordBox x:Name="ApiKeyBox" />
            </DockPanel>
            <TextBlock Text="{Binding ApiKeyStatusText}"
                       Foreground="{DynamicResource MutedForegroundBrush}"
                       FontSize="11"
                       Margin="0,0,0,12" />

            <TextBlock Text="DeepSeek API key (inline completion):" Margin="0,0,0,2" />
            <DockPanel Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Content="Save" Padding="10,2" Margin="6,0,0,0" Click="SaveDeepSeekApiKeyButton_OnClick" />
                <Button DockPanel.Dock="Right" Content="Test" Padding="10,2" Margin="6,0,0,0" Click="TestDeepSeekConnectionButton_OnClick" />
                <PasswordBox x:Name="DeepSeekApiKeyBox" />
            </DockPanel>
            <TextBlock Text="{Binding DeepSeekApiKeyStatusText}"
                       Foreground="{DynamicResource MutedForegroundBrush}"
                       FontSize="11"
                       Margin="0,0,0,16" />

            <TextBlock Text="System Prompt" FontWeight="Bold" Margin="0,0,0,8" />
            <TextBlock Text="Custom instructions prepended to every conversation (e.g. coding-style rules), replacing the built-in default that tells the assistant to act via tools rather than just describe a plan. Leave blank to keep that default."
                       FontSize="11"
                       Foreground="{DynamicResource MutedForegroundBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />
            <TextBox Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="60"
                     MaxHeight="140"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,8" />
            <Button Content="Save System Prompt" Command="{Binding SaveSystemPromptCommand}" HorizontalAlignment="Left" Padding="10,4" Margin="0,0,0,16" />

            <TextBlock Text="LM Studio" FontWeight="Bold" Margin="0,0,0,8" />
            <TextBlock Text="A chat provider alternative to OpenRouter (pick it from the provider dropdown in Copilot Chat). Codebase search embeds with a built-in model (bge-small, downloaded once on first index) unless you tick the box below."
                       FontSize="11"
                       Foreground="{DynamicResource MutedForegroundBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />

            <CheckBox Content="Use LM Studio for codebase search embeddings instead of the built-in model"
                      IsChecked="{Binding UseLmStudioEmbeddings}"
                      Margin="0,0,0,8" />

            <TextBlock Text="LM Studio base URL:" Margin="0,0,0,2" />
            <TextBox Text="{Binding LmStudioBaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

            <TextBlock Text="Embedding model name (as loaded in LM Studio):" Margin="0,0,0,2" />
            <TextBox Text="{Binding LmStudioModel, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,8"
                     ToolTip="e.g. text-embedding-nomic-embed-text-v1.5" />

            <Button Content="Save LM Studio Settings" Command="{Binding SaveLmStudioSettingsCommand}" HorizontalAlignment="Left" Padding="10,4" />

            <TextBlock Text="NuGet" FontWeight="Bold" Margin="0,0,0,8" />
            <CheckBox Content="Restore NuGet packages on solution load"
                      IsChecked="{Binding RestoreNuGetOnSolutionLoad}"
                      Margin="0,0,0,16" />

            <TextBlock Text="MCP Servers" FontWeight="Bold" Margin="0,16,0,4" />
            <TextBlock Text="Tools (Playwright, Context7, etc.) the assistant can call during chat. Launched locally as configured here - most need Node.js/npx installed."
                       FontSize="11"
                       Foreground="{DynamicResource MutedForegroundBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />

            <ItemsControl ItemsSource="{Binding McpServers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource EditProposalBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6"
                                Margin="0,0,0,6">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Server name (used as the tool-name prefix)" />
                                    <Button Grid.Column="1"
                                            Content="Remove"
                                            Padding="6,0"
                                            Margin="4,0,0,0"
                                            Command="{Binding DataContext.RemoveMcpServerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                                <TextBox Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,4,0,0"
                                         ToolTip="Command, e.g. npx" />
                                <TextBox Text="{Binding ArgsText, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,4,0,0"
                                         ToolTip="Arguments, space-separated, e.g. -y @playwright/mcp@latest" />
                                <TextBox Text="{Binding EnvText, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,4,0,0"
                                         ToolTip="Optional environment variables, KEY=VALUE;KEY2=VALUE2" />
                                <TextBlock Text="{Binding StatusText}"
                                           FontSize="10"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Add Server" Command="{Binding AddMcpServerCommand}" Padding="8,2" />
                <Button Content="+ Playwright" Command="{Binding AddPlaywrightMcpServerCommand}" Margin="4,0,0,0" Padding="8,2" />
                <Button Content="+ Context7" Command="{Binding AddContext7McpServerCommand}" Margin="4,0,0,0" Padding="8,2" />
            </StackPanel>

            <Button Content="Save &amp; Reconnect MCP Servers"
                    Command="{Binding SaveAndReconnectMcpServersCommand}"
                    HorizontalAlignment="Left"
                    Padding="10,4" />

            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,16,0,0" />

            <Button Content="Close" Padding="12,4" Margin="0,16,0,0" HorizontalAlignment="Right" Click="CloseButton_OnClick" />
        </StackPanel>
    </ScrollViewer>
</Window>
