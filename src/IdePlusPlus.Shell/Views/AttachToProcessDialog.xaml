<Window x:Class="IdePlusPlus.Shell.Views.AttachToProcessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:debug="clr-namespace:IdePlusPlus.Debug;assembly=IdePlusPlus.Debug"
        xmlns:toolPanes="clr-namespace:IdePlusPlus.Shell.ToolPanes"
        Title="Attach to Process"
        Width="480"
        Height="480"
        MinWidth="380"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextElement.Foreground="{DynamicResource WindowForegroundBrush}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Select a process to attach the debugger to:"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" Margin="6,0,0,0" Padding="10,2" />
        </Grid>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Candidates}"
                 SelectedItem="{Binding SelectedCandidate}"
                 Background="{DynamicResource PanelBackgroundBrush}"
                 BorderThickness="1"
                 MouseDoubleClick="CandidatesListBox_OnMouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type debug:ProcessAttachTarget}">
                    <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="●"
                                   Foreground="MediumSeaGreen"
                                   Visibility="{Binding IsLikelyDotNet, Converter={x:Static toolPanes:BoolToVisibilityConverter.Instance}}"
                                   ToolTip="Likely a .NET process" />
                        <TextBlock Grid.Column="1" Text="{Binding ProcessId}" />
                        <TextBlock Grid.Column="2" Text="{Binding ProcessName}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLikelyDotNet}" Value="True">
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Attach"
                    Click="AttachButton_OnClick"
                    Padding="12,4"
                    IsDefault="True">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedCandidate}" Value="{x:Null}">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Cancel" Click="CancelButton_OnClick" Margin="8,0,0,0" Padding="12,4" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
