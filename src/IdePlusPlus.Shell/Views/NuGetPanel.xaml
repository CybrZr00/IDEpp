<UserControl x:Class="IdePlusPlus.Shell.Views.NuGetPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nuget="clr-namespace:IdePlusPlus.NuGet;assembly=IdePlusPlus.NuGet">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type nuget:InstalledPackage}">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Margin="2,0">
                    <Run Text="{Binding Id, Mode=OneWay}" FontWeight="Bold" />
                    <Run Text="{Binding ResolvedVersion, Mode=OneWay}" />
                </TextBlock>
                <Button Grid.Column="1"
                        Content="Remove"
                        Click="RemoveButton_OnClick"
                        Tag="{Binding}"
                        Padding="6,0"
                        FontSize="10" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding ProjectDisplayName}"
                   FontWeight="Bold"
                   Margin="0,0,0,6" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="6,0" FontSize="11" />
            <Button Content="Restore" Command="{Binding RestoreCommand}" Margin="4,0,0,0" Padding="6,0" FontSize="11" />
            <Button Content="Add Package..." Command="{Binding OpenAddPackageDialogCommand}" Margin="4,0,0,0" Padding="6,0" FontSize="11" />
        </StackPanel>

        <ListBox Grid.Row="2"
                 ItemsSource="{Binding InstalledPackages}"
                 BorderThickness="0"
                 Background="{DynamicResource PanelBackgroundBrush}" />

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource MutedForegroundBrush}"
                   FontSize="10"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0" />
    </Grid>
</UserControl>
