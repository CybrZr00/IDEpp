<Window x:Class="IdePlusPlus.Shell.Views.ApprovalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="760"
        MinWidth="420"
        MinHeight="200"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Loaded="ApprovalDialog_OnLoaded"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextElement.Foreground="{DynamicResource WindowForegroundBrush}">

    <!--
        Replaces MessageBox for the "may I do this?" prompts. A MessageBox sizes itself to its text, so a
        long command (a Python script passed to run_command, say) makes it taller than the screen and
        pushes Yes/No out of reach. Here the long part lives in a scrolling box and the buttons sit in
        their own row, so they are always on screen. Nothing is ever truncated: the whole point of these
        prompts is consenting to the exact text.

        The window's MaxHeight (set in code, from the work area) caps the Detail row; the star row is
        what gives way when the content is too tall.
    -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="IntroText"
                   Grid.Row="0"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <TextBox x:Name="DetailBox" x:FieldModifier="public"
                 Grid.Row="1"
                 IsReadOnly="True"
                 IsReadOnlyCaretVisible="True"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 FontFamily="Consolas"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 MinHeight="48"
                 Padding="6,4"
                 Background="{DynamicResource PanelBackgroundBrush}"
                 Foreground="{DynamicResource WindowForegroundBrush}" />

        <TextBlock x:Name="ScrollHint" x:FieldModifier="public"
                   Grid.Row="2"
                   Visibility="Collapsed"
                   TextWrapping="Wrap"
                   FontSize="11"
                   Margin="0,4,0,0"
                   Foreground="{DynamicResource MutedForegroundBrush}" />

        <!-- The model's stated reason: model-controlled and so unbounded, hence its own capped scroller. -->
        <ScrollViewer x:Name="NoteScroller" x:FieldModifier="public"
                      Grid.Row="3"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto"
                      MaxHeight="110"
                      Margin="0,10,0,0">
            <TextBlock x:Name="NoteText" TextWrapping="Wrap" />
        </ScrollViewer>

        <TextBlock x:Name="WarningText"
                   Grid.Row="4"
                   Visibility="Collapsed"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0" />

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button x:Name="AllowButton" x:FieldModifier="public"
                    Content="_Allow"
                    MinWidth="84"
                    Padding="10,4"
                    Margin="0,0,8,0"
                    Click="AllowButton_OnClick" />
            <!-- Default and Cancel both: Enter, Esc and closing the window all mean No. -->
            <Button x:Name="DenyButton" x:FieldModifier="public"
                    Content="_Deny"
                    MinWidth="84"
                    Padding="10,4"
                    IsDefault="True"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
