<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="Gray" />

    <SolidColorBrush x:Key="ChatBubbleAssistantBackgroundBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="ChatBubbleUserBackgroundBrush" Color="#DCEEFF" />
    <SolidColorBrush x:Key="DiffAddedBackgroundBrush" Color="#DFF5DF" />
    <SolidColorBrush x:Key="DiffRemovedBackgroundBrush" Color="#FADADA" />
    <!-- Word-level "this specific run changed" marker within a modified line - a distinct amber
         accent reads clearly layered on top of either the added (green) or removed (pink) line
         background above, so one brush covers both contexts. -->
    <SolidColorBrush x:Key="DiffHighlightBackgroundBrush" Color="#FFE08A" />
    <SolidColorBrush x:Key="EditProposalBackgroundBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="EditProposalBorderBrush" Color="#DDDDDD" />
    <!-- A violet accent, distinct from the neutral-gray EditProposal brushes above - an adversarial
         review is deliberately a second voice, not the primary agent's own tool output. -->
    <SolidColorBrush x:Key="ReviewBackgroundBrush" Color="#F1EAFB" />
    <SolidColorBrush x:Key="ReviewBorderBrush" Color="#C9B8E8" />
    <SolidColorBrush x:Key="MenuHighlightBackgroundBrush" Color="#E5E5E5" />

</ResourceDictionary>
