<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#252526" />
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="#DCDCDC" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#9D9D9D" />

    <SolidColorBrush x:Key="ChatBubbleAssistantBackgroundBrush" Color="#3C3C3C" />
    <SolidColorBrush x:Key="ChatBubbleUserBackgroundBrush" Color="#2C4A63" />
    <SolidColorBrush x:Key="DiffAddedBackgroundBrush" Color="#1E3A1E" />
    <SolidColorBrush x:Key="DiffRemovedBackgroundBrush" Color="#4A1E1E" />
    <!-- Word-level "this specific run changed" marker within a modified line - a distinct amber
         accent reads clearly layered on top of either the added (green) or removed (red) line
         background above, so one brush covers both contexts. -->
    <SolidColorBrush x:Key="DiffHighlightBackgroundBrush" Color="#8A6D1F" />
    <SolidColorBrush x:Key="EditProposalBackgroundBrush" Color="#2D2D30" />
    <SolidColorBrush x:Key="EditProposalBorderBrush" Color="#454545" />
    <!-- A violet accent, distinct from the neutral-gray EditProposal brushes above - an adversarial
         review is deliberately a second voice, not the primary agent's own tool output. -->
    <SolidColorBrush x:Key="ReviewBackgroundBrush" Color="#332D42" />
    <SolidColorBrush x:Key="ReviewBorderBrush" Color="#5A4A78" />
    <SolidColorBrush x:Key="MenuHighlightBackgroundBrush" Color="#3C3C3C" />

</ResourceDictionary>
