<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Shell / UI -->
    <PackageVersion Include="Dirkster.AvalonDock" Version="5.0.0" />
    <PackageVersion Include="Dirkster.AvalonDock.Themes.VS2013" Version="5.0.0" />
    <PackageVersion Include="Dirkster.AvalonDock.Serializer.Xml" Version="5.0.0" />
    <PackageVersion Include="AvalonEdit" Version="6.3.1.120" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />

    <!-- Logging -->
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />

    <!-- Project system / build -->
    <PackageVersion Include="Microsoft.Build" Version="18.9.6" />
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />

    <!-- Copilot / diff -->
    <PackageVersion Include="DiffPlex" Version="1.9.0" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />

    <!-- Tests (Shouldly over FluentAssertions: FluentAssertions 8+ requires a paid license for commercial use) -->
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
  </ItemGroup>
</Project>
